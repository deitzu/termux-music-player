# termux-music-player configuration

# Subtitle timing adjustment in milliseconds.
# Positive values delay subtitles.
# Negative values make subtitles appear earlier.
SUBTITLE_OFFSET_MS=0

# How often to poll mpv for its playback position.
# Smaller values give tighter sync but use more CPU.
POLL_INTERVAL=0.10

# Maximum time in seconds for an LRCLIB request.
LRCLIB_TIMEOUT=15
