# termux-music-player configuration

# Subtitle timing adjustment in milliseconds.
# Positive values delay subtitles.
# Negative values make subtitles appear earlier.
SUBTITLE_OFFSET_MS=0

# Poll interval for termux-media-player playback position.
# Smaller values improve sync but use more CPU.
POLL_INTERVAL=0.20

# Maximum seconds for an LRCLIB request.
LRCLIB_TIMEOUT=15

# Playback backend: auto, termux or mpg123.
# auto plays .mp3 with mpg123 when it is installed (pkg install mpg123,
# about 55 MB with dependencies) and everything else with termux-media-player.
# mpg123 runs inside Termux itself and reports the position in fractions of a
# second, so lyrics sync more smoothly. It only plays mp3.
PLAYER=auto

# Colors: auto (only when printing to a terminal and NO_COLOR is unset),
# always, or never. Can also be set per run with --color / --no-color.
COLOR=auto

# Karaoke-style lyrics: the sentence being sung is redrawn in place and
# highlighted from left to right as the song plays (needs a terminal).
# LRC files only have one timestamp per sentence, so the sweep is an estimate
# spread over the time until the next sentence, at most LYRIC_SWEEP_MAX_MS.
# Set LYRIC_SWEEP=0 to print each sentence once instead.
LYRIC_SWEEP=1
LYRIC_SWEEP_MAX_MS=5000

# 256-color codes (0-255): the sung part, the part still to come, and
# sentences that are already done.
LYRIC_HI_COLOR=87
LYRIC_LO_COLOR=240
LYRIC_DONE_COLOR=250
